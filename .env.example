# Search Layer (Tavily). Omit to run the search layer in keyless mode.
TAVILY_API_KEY=

# Crawl Layer (Firecrawl). Omit to run the crawl layer in keyless mode
# (cloud, rate-limited, limited tool subset).
FIRECRAWL_API_KEY=

# Optional: point the crawl layer at a self-hosted Firecrawl instance.
# When set, FIRECRAWL_API_KEY may be optional depending on your instance.
# FIRECRAWL_API_URL=https://firecrawl.your-domain.com