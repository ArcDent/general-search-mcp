# Search Layer (Tavily). Omit to run the search layer in keyless mode.
# Several keys may be listed, comma-separated: tvly-aaa,tvly-bbb
TAVILY_API_KEY=

# Crawl Layer (Firecrawl). Omit to run the crawl layer in keyless mode
# (cloud, rate-limited, limited tool subset).
# Several keys may be listed, comma-separated: fc-aaa,fc-bbb
FIRECRAWL_API_KEY=

# Optional: how a layer with several keys picks one. "sequential" (default)
# keeps using the first usable key and moves on only when it is rejected or out
# of credits; "round-robin" moves to the next key on every call.
# Keep multi-key values in this file or the server's own env block, not in a
# global shell profile, where other Firecrawl tools would read the raw list.
KEY_ROTATION=

# Optional: point the crawl layer at a self-hosted Firecrawl instance.
# When set, FIRECRAWL_API_KEY may be optional depending on your instance.
# FIRECRAWL_API_URL=https://firecrawl.your-domain.com